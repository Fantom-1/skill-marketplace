{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Brand AI-Readiness Audit Report Schema",
  "type": "object",
  "required": [
    "site",
    "audited_at",
    "is_spa_degraded",
    "summary",
    "findings",
    "proactive_recommendations"
  ],
  "properties": {
    "site": {
      "type": "string",
      "description": "Domain or URL of the audited website."
    },
    "audited_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of the audit execution."
    },
    "is_spa_degraded": {
      "type": "boolean",
      "description": "Indicates if the site is an SPA, which degrades the confidence of HTML-only schema parsing."
    },
    "summary": {
      "type": "object",
      "required": [
        "total_findings",
        "critical",
        "high",
        "medium",
        "low"
      ],
      "properties": {
        "total_findings": {
          "type": "integer",
          "minimum": 0
        },
        "critical": {
          "type": "integer",
          "minimum": 0
        },
        "high": {
          "type": "integer",
          "minimum": 0
        },
        "medium": {
          "type": "integer",
          "minimum": 0
        },
        "low": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "skill_source",
          "category",
          "title",
          "severity",
          "confidence",
          "evidence",
          "suggested_action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique finding code (e.g. CRAWL-001, SCHEMA-002, IDENT-001, ENGAGE-005)."
          },
          "skill_source": {
            "type": "string",
            "description": "The audit skill that generated this finding."
          },
          "category": {
            "type": "string",
            "enum": [
              "discoverability",
              "engagement",
              "freshness",
              "identity"
            ]
          },
          "title": {
            "type": "string",
            "description": "Concise summary of the audit finding."
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ],
            "description": "Confidence in the finding, often degraded for SPAs."
          },
          "evidence": {
            "type": "string",
            "description": "Empirical evidence captured from the webpage HTML or headers."
          },
          "suggested_action": {
            "type": "object",
            "required": [
              "summary",
              "detail",
              "priority",
              "effort"
            ],
            "properties": {
              "summary": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "priority": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "effort": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          }
        }
      }
    },
    "proactive_recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "rationale",
          "suggested_action"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "suggested_action": {
            "type": "string"
          }
        }
      }
    }
  }
}
